#: templates/account/email/email_confirmation_message.txt:1
#, python-format
msgid "Hello,\n\n"
"You're receiving this email because you (or somebody else) is trying to change their HSReplay.net email address. We need to verify that you own it.\n\n"
"If this is correct, go to the following URL within three days to confirm:\n\n"
"%(activate_url)s\n\n"
"If this was not you, you can simply ignore this email.\n\n"
"Cheers,\n"
"The HSReplay.net Team\n"
msgstr "Hola,\n\n"
"Estás recibiendo este correo porque tú (o alguien más) está tratando de cambiar su dirección de correo en HSReplay.net. Necesitamos que verifiques que eres el dueño.\n\n"
"Si es asi, abre el siguiente enlace dentro de los siguientes tres días para confirmar:\n\n"
"%(activate_url)s\n\n"
"Si no fuiste tu, simplemente ignora este correo.\n\n"
"Saludos,\n"
"El equipo HSReplay.net\n"

#: templates/account/email/email_confirmation_signup_message.txt:1
#, python-format
msgid "Hello,\n\n"
"You're receiving this email because you (or somebody else) is trying to create a new HSReplay.net account with this email address. We need to verify that you own it.\n\n"
"If this is correct, go to the following URL within three days to confirm:\n\n"
"%(activate_url)s\n\n"
"If this was not you, you can simply ignore this email.\n\n"
"Cheers,\n"
"The HSReplay.net Team\n"
msgstr "Hola,\n\n"
"Estás recibiendo este correo porque tú (o alguien más) está tratando de crear una nueva cuenta en HSReplay.net. Necesitamos que verifiques que eres el dueño.\n\n"
"Si es correcto, ve al siguiente enlace dentro de los siguientes tres días para confirmar:\n\n"
"%(activate_url)s\n\n"
"Si no fuiste tu, simplemente ignora este correo.\n\n"
"Saludos,\n"
"El equipo HSReplay.net\n"

